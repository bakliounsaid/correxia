# CORREXIA Backend (FastAPI) — copier vers backend/.env et renseigner les clés.
# Ce fichier contient des secrets : ne jamais le versionner (backend/.env est dans .gitignore).

APP_NAME=CORREXIA API
# true en local pour activer /docs et /openapi.json
DEBUG=false

# Frontend Next.js : origines autorisées (CORS) + URL publique (redirections Stripe)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Postgres Supabase : Project Settings → Database → Connection string → mode « Session »
# (pooler, port 5432). Remplacer [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Supabase Auth : même projet que le frontend
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (sb_publishable_… ou anon eyJ…) : sert à vérifier les jetons des utilisateurs
SUPABASE_ANON_KEY=sb_publishable_...
# Clé service (secrète) : Admin API (création des comptes enseignants d'établissement)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (génération d'évaluations + correction IA)
OPENAI_API_KEY=
# OPENAI_OCR_MODEL=gpt-4o
# OPENAI_GRADE_MODEL=gpt-4o-mini

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ADVANCED_QUARTERLY=price_...
STRIPE_PRICE_MASTERY_QUARTERLY=price_...
STRIPE_PRICE_ESTABLISHMENT_QUARTERLY=price_...

# Lancer en local (Windows : la boucle Selector est requise par psycopg) :
#   cd backend
#   .venv\Scripts\python -m uvicorn app.main:app --reload --port 8000 --loop asyncio:SelectorEventLoop
