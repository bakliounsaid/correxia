# CORREXIA Backend — copier vers backend/.env et renseigner les clés

APP_NAME=CORREXIA API
# true en local pour activer /docs et /openapi.json
DEBUG=false

# Supabase — URL du projet + cle **anon public (legacy)** = long JWT eyJhbGciOi...
# Ne PAS utiliser la cle "Publishable" (sb_publishable_...) : PostgREST la refuse (401).
# Dashboard : Project Settings > API, ou Connect > API Keys > copier "anon" / legacy.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic / Claude (optionnel — correction IA, RAG, etc.)
ANTHROPIC_API_KEY=

# Upload
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,txt

# CORS (origines séparées par des virgules) — ajoute http://localhost:3000 si le front est Next.js local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Optionnel : SQLAlchemy + auth JWT maison (routes /auth, /tests, …) ---
# DATABASE_URL=postgresql+psycopg_async://postgres:postgres@localhost:5432/correxia
# SECRET_KEY=changez-moi-en-production-minimum-32-caracteres

# Stripe — 2 variables suffisent pour la base : clé secrète + URL de retour après paiement réussi
STRIPE_KEY=sk_test_...
STRIPE_LINK=http://localhost:3000/dashboard?checkout=success
# Annulation (optionnel, sinon garde la valeur par défaut du code)
# STRIPE_CANCEL_URL=http://localhost:3000/dashboard?checkout=cancel
# Webhook + prix (optionnel — requis pour POST /api/v1/subscriptions/checkout multi-plans)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ADVANCED_QUARTERLY=price_1TMpLKJPffDLTofDogBBi8rU
# STRIPE_PRICE_MASTERY_QUARTERLY=price_1TMpLKJPffDLTofD6UTM0ZxO
# STRIPE_PRICE_ESTABLISHMENT_QUARTERLY=price_1TMpLKJPffDLTofDs5qstpNh

# Tester connexion Supabase + Stripe (aucun secret dans la reponse) :
#   cd backend
#   py scripts/check_integrations.py
# ou demarrer l’API puis : GET /api/v1/health/integrations
