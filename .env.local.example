# =============================================================================
# FRONT NEXT.JS — copier ce fichier en .env.local à la RACINE du repo (pas dans /backend)
# Redémarrer `npm run dev` après modification.
# =============================================================================
#
# Seules les variables préfixées NEXT_PUBLIC_ sont accessibles dans le navigateur.
# Ne mets JAMAIS de clé service_role ou secret Stripe ici.
#
# Même projet que backend/.env : URL + cle **anon legacy** JWT (eyJ...), pas sb_publishable_...
# Project Settings > API (ou Connect > API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Auth : dans le dashboard, Authentication > URL configuration,
# ajoutez en Redirect URLs : http://localhost:3000/auth/callback
# (et votre domaine de prod + /auth/callback)

# Optionnel : API FastAPI locale (axios dans src/lib/api.ts)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optionnel : Stripe.js dans le navigateur uniquement
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Paiement abonnement établissement (routes /api/billing/* — jamais exposer au navigateur)
# STRIPE_SECRET_KEY=sk_test_...
# Price ID du pack Établissement (trimestriel), depuis le dashboard Stripe
# STRIPE_PRICE_ESTABLISHMENT_QUARTERLY=price_...
# Packs enseignant individuel (trimestriel)
# STRIPE_PRICE_ADVANCED_QUARTERLY=price_...
# STRIPE_PRICE_MASTERY_QUARTERLY=price_...
# URL du site pour les redirections Stripe si Origin absent (ex. cron / serverless)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
